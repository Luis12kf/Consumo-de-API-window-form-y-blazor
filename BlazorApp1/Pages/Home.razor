@page "/"
@using BlazorApp1.modelos
@using System.Text.Json
@inject HttpClient Http

<PageTitle>Lista de estudiantes</PageTitle>

<div class="container my-4">
    <div class="d-flex justify-content-between align-items-center mb-3">
        <h3>Listado de Estudiantes</h3>
        <span class="badge bg-primary">Total: @(estudiantes?.Count ?? 0)</span>
    </div>

    @if (errorMensaje != null)
    {
        <div class="alert alert-danger shadow-sm my-3">
            <strong>Error al conectar con la API:</strong> @errorMensaje
        </div>
    }
    else if (estudiantes == null)
    {
        <div class="d-flex align-items-center gap-2 my-4">
            <div class="spinner-border text-primary" role="status"></div>
            <span>Cargando información...</span>
        </div>
    }
    else if (!estudiantes.Any())
    {
        <div class="alert alert-warning text-center" role="alert">
            No se encontraron registros de estudiantes.
        </div>
    }
    else
    {
        <div class="table-responsive shadow-sm rounded">
            <table class="table table-striped table-hover align-middle mb-0">
                <thead class="table-dark">
                    <tr>
                        <th>ID</th>
                        <th>Matrícula</th>
                        <th>Cédula</th>
                        <th>Nombre Completo</th>
                        <th>Carrera</th>
                        <th>Contacto</th>
                        <th>Nacionalidad</th>
                        <th>F. Nacimiento</th>
                        <th>F. Ingreso</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var item in estudiantes)
                    {
                        <tr>
                            <td><strong>#@item.Id</strong></td>
                            <td><span class="badge bg-secondary">@item.Matricula</span></td>
                            <td>@item.Cedula</td>
                            <td>@item.Nombre @item.Apellido</td>
                            <td>@item.Carrera</td>
                            <td>
                                <div><small class="text-muted">✉</small> @item.Email</div>
                                <div><small class="text-muted">📞</small> @item.Telefono</div>
                            </td>
                            <td>@item.Nacionalidad</td>
                            <td>@item.FechaNacimiento.ToString("dd/MM/yyyy")</td>
                            <td>@item.FechaIngreso.ToString("dd/MM/yyyy")</td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    }
</div>

@code {
    private List<Root>? estudiantes;
    private string? errorMensaje;

    protected override async Task OnInitializedAsync()
    {
        try
        {
            var opciones = new JsonSerializerOptions
            {
                PropertyNameCaseInsensitive = true
            };

            estudiantes = await Http.GetFromJsonAsync<List<Root>>("api/estudiantes", opciones);
        }
        catch (Exception ex)
        {
            errorMensaje = ex.Message;
            Console.WriteLine($"Error al consumir la API: {ex.Message}");
        }
    }
}g
